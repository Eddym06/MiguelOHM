	)
	(text "GPIO39, GPIO40 y GPIO42 NO son pines libres: \nlos usa el expansor PCA9555 (GPIO39 = SCL, GPIO40 = SDA e INT en GPIO42). \nAparecen en la hoja solo para compartir el bus I2C con GPS, IMU, INA219 y J20."
		(exclude_from_sim no)
		(at 160.528 106.348 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c306708e-02d1-4f73-b1f0-09feb914a2a8")
	)
