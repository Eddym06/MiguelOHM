# -*- coding: utf-8 -*-
"""Macro: colorea el ensamble del carrito por zona. Abre carrito_ensamble.FCStd y ejecuta esta macro
(Macro > Macros... > colorear_por_zona.FCMacro > Ejecutar). Guarda con Ctrl+S para conservar los colores."""
import FreeCAD as App
import FreeCADGui as Gui

COLORES = {   # R, G, B (0-1)
    "estructura": (0.60, 0.60, 0.57),
    "sensores":   (0.22, 0.54, 0.87),   # azul
    "logica":     (0.50, 0.47, 0.87),   # violeta
    "potencia":   (0.89, 0.29, 0.29),   # rojo
    "aleron":     (0.33, 0.29, 0.72),
    "motor":      (0.85, 0.35, 0.19),
    "rueda":      (0.15, 0.15, 0.15),
}
ESPECIALES = {"PCB": (0.06, 0.43, 0.34), "Lidar": (0.10, 0.10, 0.12), "GPS": (0.10, 0.10, 0.12),
              "Bateria": (0.11, 0.62, 0.46), "Tira_LED": (0.94, 0.62, 0.15),
              "Faro_Izq": (0.98, 0.85, 0.45), "Faro_Der": (0.98, 0.85, 0.45)}


def colorear(doc):
    for o in doc.Objects:
        if not hasattr(o, "Zona") or o.ViewObject is None:
            continue
        c = ESPECIALES.get(o.Name) or (ESPECIALES["Tira_LED"] if o.Name.startswith("LED_") else COLORES.get(o.Zona))
        if c:
            o.ViewObject.ShapeColor = c
        if o.Name.startswith("Rueda"):
            o.ViewObject.Transparency = 0
    Gui.SendMsgToActiveView("ViewFit")


colorear(App.ActiveDocument)
